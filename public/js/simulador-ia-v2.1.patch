+        const closing = Math.max(0, Math.min(31, Number(c.closingDay || 0)));
+        const due = Math.max(0, Math.min(31, Number(c.dueDay || 0)));
+        if (!closing || !due) return `• ${nome}: fechamento/vencimento não configurados (não dá para calcular a virada).`;
+        const off = consultantFirstBillOffset(closing, due, d);
+        const key = (typeof addMonthsToKey === 'function') ? addMonthsToKey(startKey, off) : startKey;
+        const venc = `${String(due).padStart(2, '0')}/${key.slice(5, 7)}/${key.slice(0, 4)}`;
