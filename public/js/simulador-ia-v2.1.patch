+    const [y, m, d] = String(todayStr).split('-').map(Number);
+    const startKey = `${y}-${String(m).padStart(2, '0')}`;
+    const hojeBR = `${String(d).padStart(2, '0')}/${String(m).padStart(2, '0')}`;
+    return cards.map(c => {
