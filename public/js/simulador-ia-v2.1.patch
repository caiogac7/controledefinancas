+// =========================================================================
+// CONSULTOR v2 — INÍCIO
+// O chat antes só via o MÊS ATUAL e por isso "inventava" dezembro/janeiro.
+// Agora ele recebe: projeção mês a mês, cartões com a virada calculada, parcelas e histórico.
+// =========================================================================
+function consultantFirstBillOffset(closingDay, dueDay, day) {
+    // Mesma regra do Simulador de Compras.
+    if (dueDay > closingDay) return day < closingDay ? 0 : 1;
+    return day < closingDay ? 1 : 2;
+}
+
+function consultantMonthLabel(key) {
+    try {
+        const obj = (typeof MONTHS !== 'undefined' && Array.isArray(MONTHS)) ? MONTHS.find(m => m.key === key) : null;
+        if (obj && obj.label) return obj.label;
+    } catch (_) { /* usa o fallback abaixo */ }
+    return simMonthLabel(key);
+}
+
+function buildConsultantCardsText(todayStr) {
+    const cards = (typeof savedCards !== 'undefined' && Array.isArray(savedCards)) ? savedCards : [];
+    if (!cards.length) return 'Nenhum cartão de crédito cadastrado.';
+    const [y, m, d] = String(todayStr).split('-').map(Number);
+    const startKey = `${y}-${String(m).padStart(2, '0')}`;
+    const hojeBR = `${String(d).padStart(2, '0')}/${String(m).padStart(2, '0')}`;
+    return cards.map(c => {
+        const nome = c.name || c.alias || 'Cartão';
+        const closing = Math.max(0, Math.min(31, Number(c.closingDay || 0)));
+        const due = Math.max(0, Math.min(31, Number(c.dueDay || 0)));
+        if (!closing || !due) return `• ${nome}: fechamento/vencimento não configurados (não dá para calcular a virada).`;
+        const off = consultantFirstBillOffset(closing, due, d);
+        const key = (typeof addMonthsToKey === 'function') ? addMonthsToKey(startKey, off) : startKey;
+        const venc = `${String(due).padStart(2, '0')}/${key.slice(5, 7)}/${key.slice(0, 4)}`;
+        const efeito = off === 0
+            ? 'IMPACTA o caixa DESTE mês'
+            : `NÃO impacta o caixa deste mês; só começa a pesar em ${consultantMonthLabel(key)}`;
+        return `• ${nome}: fecha dia ${closing}, vence dia ${due}. Uma compra feita HOJE (${hojeBR}) tem a 1ª parcela vencendo em ${venc} (${efeito}).`;
+    }).join('\n');
+}
+
+function buildConsultantProjectionText(ctx) {
+    const fmt = (n) => formatSimMoney(n);
+    const hist = computeHistoricalMonthlyExpense(ctx.curMonthKey);
+    let acumulado = Number(ctx.projectedMonthBalance || 0);
+    const linhas = [`• ${ctx.currentMonthLabel} (mês atual): saldo projetado no fim do mês ${fmt(acumulado)} (fato do app: saldo em conta + receitas pendentes - despesas pendentes)`];
+    for (let i = 1; i <= 6; i++) {
+        const key = (typeof addMonthsToKey === 'function') ? addMonthsToKey(ctx.curMonthKey, i) : ctx.curMonthKey;
+        let txs = [];
+        try {
+            if (typeof ensureMonthExists === 'function') ensureMonthExists(key, true);
+            txs = (typeof getHomeVisibleTransactions === 'function') ? (getHomeVisibleTransactions(key) || []) : [];
+        } catch (_) { txs = []; }
+        const recLancada = txs.filter(t => t && t.type === 'income').reduce((a, b) => a + Number(b.amount || 0), 0);
+        const despLancada = txs.filter(t => t && t.type === 'expense').reduce((a, b) => a + (b.isConsolidatedBill
+            ? Number(b.total_amount ?? b.invoiceTotal ?? b.amount ?? 0)
+            : Number(b.amount || 0)), 0);
+        const recEstimada = recLancada === 0 && Number(ctx.totalIncome) > 0;
+        const rec = recEstimada ? Number(ctx.totalIncome) : recLancada;
+        const despBase = Math.max(despLancada, hist);
+        const resultado = rec - despBase;
+        acumulado += resultado;
+        linhas.push(
+            `• ${consultantMonthLabel(key)}: receita ${fmt(rec)}${recEstimada ? ' (ESTIMADA: ainda sem receita lançada, usei a do mês atual)' : ''}`
+            + ` | despesas já lançadas ${fmt(despLancada)} | gasto médio histórico ${fmt(hist)}`
+            + ` | resultado conservador do mês ${fmt(resultado)} | saldo acumulado estimado ${fmt(acumulado)}`
+        );
+    }
+    return linhas.join('\n');
+}
+
+function buildConsultantInstallmentsText(ctx, auditData) {
+    const list = (auditData && auditData.installmentList) || [];
+    if (!list.length) return 'Nenhuma compra parcelada em andamento registrada.';
+    return list.map(p => {
+        const libera = (p.remainingInst >= 0 && typeof addMonthsToKey === 'function')
+            ? consultantMonthLabel(addMonthsToKey(ctx.curMonthKey, p.remainingInst + 1))
+            : '-';
+        return `• "${p.name}": parcela ${p.currentInst}/${p.totalInst} de ${formatSimMoney(p.amount)}. Faltam ${p.remainingInst}. Última parcela em ${p.endMonthLabel}; libera ${formatSimMoney(p.amount)}/mês a partir de ${libera}.`;
+    }).join('\n');
+}
+
+function buildConsultantExpensesText(auditData) {
+    const exps = (auditData && auditData.currentMonthExpenses) || [];
+    if (!exps.length) return 'Nenhuma despesa cadastrada para este mês.';
+    const byCat = {};
+    exps.forEach(d => { const c = d.cat || 'Geral'; byCat[c] = (byCat[c] || 0) + Number(d.amount || 0); });
+    const cats = Object.entries(byCat).sort((a, b) => b[1] - a[1]).slice(0, 8)
+        .map(([c, v]) => `${c}: ${formatSimMoney(v)}`).join(' | ');
+    const top = exps.slice().sort((a, b) => Number(b.amount || 0) - Number(a.amount || 0)).slice(0, 15)
+        .map(d => `• ${d.desc}: ${formatSimMoney(d.amount)} (${d.paid ? 'pago' : 'pendente'}, ${d.cat || 'Geral'})`).join('\n');
+    return `Total por categoria: ${cats}\nMaiores despesas:\n${top}`;
+}
+
