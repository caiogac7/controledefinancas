+/** Converte o histórico do chat em turnos do Gemini (começa em "user", alterna papéis). */
+function buildGeminiHistoryContents(history, maxItems) {
+    const items = (Array.isArray(history) ? history : []).slice(-(maxItems || 12))
+        .filter(m => m && String(m.text || '').trim());
+    const out = [];
+    items.forEach(m => {
+        const role = m.role === 'user' ? 'user' : 'model';
+        const text = String(m.text).trim();
+        if (!out.length && role !== 'user') return;
+        if (out.length && out[out.length - 1].role === role) {
+            out[out.length - 1].parts[0].text += '\n\n' + text;
+        } else {
+            out.push({ role, parts: [{ text }] });
+        }
+    });
+    return out;
+}
